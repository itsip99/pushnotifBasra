# dependencies
/node_modules

# env
.env

# token storage
/data

# compiled Go binaries -- dibuild ulang saat deploy, bukan disimpan di git
/go/bin

# hasil build -- dibuat ulang di server oleh deploy.cmd (npx tsc)
/dist

# log runtime
/logs

# credential service account Firebase -- disalin manual ke server, JANGAN masuk git
/src/services/**/*.json
/go/credentials/*.json

# penanda versi yang sedang jalan di server
/DEPLOYED_VERSION.txt
