{
  // Opsi sama dengan sebelumnya; template komentar bawaan `tsc --init` dibuang supaya mudah dibaca.
  "compilerOptions": {
    "target": "es2016",
    "module": "commonjs",
    "rootDir": "./src",
    "outDir": "./dist",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    // Build berikutnya hanya memeriksa file yang berubah.
    // File info disimpan di dalam dist supaya ikut terhapus kalau dist dihapus
    // (kalau tertinggal di luar, tsc bisa menganggap tidak ada yang perlu di-emit).
    "incremental": true,
    "tsBuildInfoFile": "./dist/.tsbuildinfo"
  },
  // Dibatasi ke src supaya folder lain (go/, scripts/, dist/) tidak ikut terbaca tsc.
  "include": ["src"]
}
