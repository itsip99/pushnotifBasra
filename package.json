  "main": "index.ts",
  "scripts": {
    "build": "npx tsc",
    "start": "nodemon dist/index.js",
    "start:api": "pm2 start dist/index.js -i 2 --name service-notif",
    "start:hris": "pm2 start dist/worker.hris.js --name worker-hris",
    "start:javayoga": "pm2 start dist/worker.javayoga.js --name worker-javayoga",
    "start:wellness": "pm2 start dist/worker.javawellness.js --name worker-wellness",
    "start:lsa": "pm2 start dist/worker.lsa.js --name worker-lsa",
    "start:fixupmoto": "pm2 start dist/worker.fixupmoto.js --name worker-fixupmoto",
    "start:all": "npm run start:api && npm run start:hris && npm run start:javayoga && npm run start:wellness && npm run start:lsa && npm run start:fixupmoto",
    "restart:all": "pm2 restart service-notif && pm2 restart worker-hris && pm2 restart worker-javayoga && pm2 restart worker-wellness && pm2 restart worker-lsa && pm2 restart worker-fixupmoto",
    "stop:all": "pm2 stop service-notif && pm2 stop worker-hris && pm2 stop worker-javayoga && pm2 stop worker-wellness && pm2 stop worker-lsa && pm2 stop worker-fixupmoto",
    "dev": "nodemon src/index.ts",
    "worker": "nodemon src/worker.ts",
    "test:fire": "node scripts/test-fire.js",
    "test:fire:prod": "BASE_URL=http://203.201.175.81:5000 node scripts/test-fire.js"
  },
